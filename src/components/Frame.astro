---
/**
 * Frame — the atom of this world. One cell of 16mm film printed onto a contact sheet: a white
 * print held between grey stock, perforation rails on both sides, frame lines above and below.
 * Every frame is a print surface: it resets the role tokens, so it reads the same on paper, beige or stock.
 *
 *  state   latent    → underexposed: pale, grey, muted text; develops on hover/focus/active (coming soon)
 *          projected → full print (default)
 *          fogged    → sepia-toned, stained (the past: finished events)
 *  leak    adds a McGill-red light leak that burns in on the print from the right rail on hover/focus and when
 *          `.is-lit` (the one frame per strip that means something: next to develop, latest, live).
 *          A lit frame's numeral is also circled in red china marker (an authored SVG stroke that draws itself).
 *          `.is-active` (set by Strip for the centred frame) only develops a latent frame; it never lights.
 *  numeral china-marker number top-left (episode number, step, date)
 *  code    stamped edge code along the bottom (metadata, never prose)
 *  wear    0–2 density of scratches over the media slot
 *  as      element tag ('article', 'a', 'li', …). Extra attributes pass through (href, id, aria-*).
 *
 *  <Frame as="article" state="latent" leak numeral="03" code="REEL 01 · FRAME 03 · COMING SOON">
 *    <Placeholder slot="media" kind="photo" label="Guest photo" ratio="16 / 10" />
 *    <h3 class="title">…</h3><p>…</p>
 *  </Frame>
 *
 *  Inside a <Strip>, frames drop their own rails; the strip's rails carry the perforations.
 */
interface Props {
  as?: string;
  state?: 'latent' | 'projected' | 'fogged';
  leak?: boolean;
  numeral?: string | number;
  numeralLabel?: string;
  code?: string;
  wear?: 0 | 1 | 2;
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', state = 'projected', leak = false, numeral, numeralLabel = 'Frame', code, wear = 1, class: cls = '', ...rest } = Astro.props;
// A named slot registers even when its condition is false, so render the media wrapper only when it has output.
const mediaHtml = Astro.slots.has('media') ? (await Astro.slots.render('media')).trim() : '';
const hasMedia = mediaHtml.length > 0;
const hasNumeral = numeral !== undefined && numeral !== '';
// Three hand-drawn china-marker rings (open, overlapping ends). The numeral picks one, so a sheet never repeats a stroke.
const RINGS = [
  'M18 14C34 4 78 3 92 20C101 33 88 52 58 56C30 59 6 50 5 33C4 20 20 10 44 8C56 7 66 9 73 13',
  'M70 8C88 10 99 24 94 38C88 52 60 58 36 55C14 52 2 40 6 26C10 12 32 4 56 5C67 6 75 9 82 15',
  'M30 9C52 2 86 6 95 24C102 40 80 55 50 56C22 57 3 46 4 30C5 16 22 7 42 6C52 5 60 7 66 10',
];
const ring = RINGS[String(numeral ?? '').split('').reduce((n, c) => n + c.charCodeAt(0), 0) % RINGS.length];
---
<Tag class:list={['frame', `is-${state}`, cls, { 'has-media': hasMedia, 'has-numeral': hasNumeral }]} data-leak={leak ? '' : undefined} data-wear={wear} {...rest}>
  <span class="frame__rail frame__rail--l perf" aria-hidden="true"></span>
  {hasMedia && <div class="frame__media" set:html={mediaHtml} />}
  <div class="frame__body"><slot /></div>
  {code && <span class="frame__code edge-code">{code}</span>}
  <span class="frame__rail frame__rail--r perf" aria-hidden="true"></span>
  {leak && <span class="frame__leak" aria-hidden="true"></span>}
  {hasNumeral && (
    <span class="frame__numeral grease"><span class="visually-hidden">{numeralLabel} </span>{numeral}<svg class="frame__ring" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={ring} pathLength="1" /><path class="frame__ring-wax" d={ring} pathLength="1" transform="translate(1.6 1.8)" /></svg></span>
  )}
</Tag>

<style>
  .frame {
    /* a print: always light, whatever surface it lies on */
    --bg: var(--print); --fg: var(--ink); --fg-strong: var(--ink-strong); --fg-muted: var(--ink-muted); --fg-faint: var(--ink-faint);
    --line: color-mix(in oklab, var(--ink) 13%, transparent); --line-strong: color-mix(in oklab, var(--ink) 28%, transparent);
    --toned: var(--sepia); --toned-dim: var(--sepia-dim); --mark: var(--red); --mark-ink: var(--on-red);
    --frame-bg: var(--print);
    --rail: var(--perf-w);
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) var(--rail);
    grid-template-rows: auto 1fr auto;
    /* the print fills only between the rails, so the perforations are holes onto whatever lies beneath */
    background: linear-gradient(to right, transparent var(--rail), var(--frame-bg) var(--rail) calc(100% - var(--rail)), transparent calc(100% - var(--rail)));
    border-block: var(--frame-line) solid var(--stock);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-frame);
    color: var(--fg);
    isolation: isolate;
    overflow: clip;
    text-decoration: none;
    /* longhands, not the shorthand: a frame that also carries data-reveal keeps the reveal's delay */
    transition-property: translate, box-shadow, color, background-color;
    transition-duration: var(--dur-3);
    transition-timing-function: var(--ease-out);
  }
  /* a frame that develops on enter merges the reveal's properties with its own; the print darkens last */
  :global(.js) .frame[data-reveal] {
    transition-property: opacity, translate, filter, box-shadow, color, background-color;
    transition-duration: var(--dur-3), var(--dur-3), var(--dur-5), var(--dur-3), var(--dur-3), var(--dur-3);
  }
  .frame__rail { grid-row: 1 / -1; z-index: 3; }
  .frame__rail--l { grid-column: 1; }
  .frame__rail--r { grid-column: 3; }
  .frame__media { grid-column: 2; grid-row: 1; position: relative; z-index: 1; overflow: hidden; background: var(--beige); transition: filter var(--dur-4) var(--ease-out); }
  .frame__media > :global(*) { width: 100%; height: 100%; }
  .frame__media > :global(img), .frame__media > :global(video) { object-fit: cover; }
  /* dust and scratches on the print: procedural, per frame, density by data-wear */
  .frame__media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; opacity: var(--wear, 0.5);
    background: url('../assets/textures/scratches.svg') center / cover no-repeat;
  }
  .frame[data-wear='2'] .frame__media::after { background-position: 30% 60%; }
  .frame[data-wear='0'] { --wear: 0; }
  .frame[data-wear='1'] { --wear: 0.5; }
  .frame[data-wear='2'] { --wear: 0.85; }
  .frame__body { grid-column: 2; grid-row: 2; position: relative; z-index: 1; display: grid; gap: var(--s-3); align-content: start; padding: var(--s-5) var(--s-5) var(--s-6); }
  .frame.has-numeral:not(.has-media) .frame__body { padding-block-start: var(--s-8); }
  .frame__code { grid-column: 2; grid-row: 3; position: relative; z-index: 1; padding: var(--s-3) var(--s-5) var(--s-4); border-block-start: 1px dashed var(--line); }
  .frame__numeral { position: absolute; z-index: 4; top: var(--s-2); left: calc(var(--perf-w) + var(--s-3)); pointer-events: none; }
  /* over a real photograph the numeral is written in white marker */
  .frame:has(.frame__media > img) .frame__numeral { color: #ffffff; text-shadow: 0 1px 3px rgb(0 0 0 / 0.55); }

  /* the light leak: McGill red burning in from the right edge of the print. Multiplied, so the ink stays ink and
     only the paper turns red; clipped at the right rail (the box overhangs the frame by 10%, 1/8 of its width),
     so the stock and its perforations never redden. */
  .frame__leak {
    position: absolute; inset: -25% -10% -25% 30%; z-index: 2; pointer-events: none; opacity: 0;
    clip-path: inset(0 calc(12.5% + var(--rail)) 0 0);
    background:
      linear-gradient(to left, color-mix(in oklab, var(--red-bright) 90%, transparent), transparent 16%),
      radial-gradient(60% 96% at 100% 50%, var(--red-bright) 0%, var(--red) 16%, color-mix(in oklab, var(--red) 58%, transparent) 36%, color-mix(in oklab, var(--red) 20%, transparent) 56%, transparent 72%);
    mix-blend-mode: multiply;
    -webkit-mask-image: url('../assets/textures/grain-alpha.png'), url('../assets/textures/blotch-alpha.png');
    -webkit-mask-size: 256px 256px, 640px 640px;
    -webkit-mask-composite: source-over;
    mask-image: url('../assets/textures/grain-alpha.png'), url('../assets/textures/blotch-alpha.png');
    mask-size: 256px 256px, 640px 640px;
    mask-composite: add; /* union, not intersect: the textures mottle the red (83–96% strength) instead of halving it */
    transition: opacity var(--dur-4) var(--ease-out);
  }
  /* the leak means something: the lit frame (next to develop / latest / live). Hover and focus preview it; .is-active only develops. */
  .frame[data-leak].is-lit .frame__leak { opacity: 0.55; }
  .frame[data-leak]:is(:hover, :focus-within) .frame__leak { opacity: 0.72; }

  /* the china-marker ring: an authored, open, double-pass stroke that draws itself round the numeral.
     Lit frames carry it; it draws when the print develops (or on load in the hero). */
  .frame__numeral { padding: 0.1em 0.45em 0.16em; margin: -0.1em 0 0 -0.45em; transition: color var(--dur-2) var(--ease-out); }
  .frame__ring { position: absolute; left: -0.08em; top: -0.06em; width: calc(100% + 0.16em); height: calc(100% + 0.12em); overflow: visible; pointer-events: none; }
  .frame__ring path { fill: none; stroke: var(--red); stroke-width: 4.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 1; stroke-dashoffset: 1; filter: url(#wax); transition: stroke-dashoffset 1000ms var(--ease-in-out) 450ms; }
  .frame__ring .frame__ring-wax { stroke-width: 1.6; opacity: 0.55; transition-delay: 600ms; }
  .frame.is-lit .frame__numeral { color: var(--red); text-shadow: none; }
  .frame.is-lit .frame__ring path { stroke-dashoffset: 0; }
  /* not yet developed: the ring waits, so it draws as the print surfaces */
  :global(.js) :is([data-reveal]:not(.is-in) .frame, .frame[data-reveal]:not(.is-in)) .frame__ring path { stroke-dashoffset: 1; transition: none; }

  /* states */
  .frame.is-latent { color: var(--fg-muted); }
  .frame.is-latent .frame__media { filter: grayscale(0.5) brightness(1.13); } /* underexposed: a pale ghost on white paper */
  .frame.is-latent:is(:hover, :focus-within, .is-active) { color: var(--fg); }
  .frame.is-latent:is(:hover, :focus-within, .is-active) .frame__media { filter: none; }
  .frame.is-fogged { --frame-bg: var(--paper-2); color: var(--fg-muted); }
  .frame.is-fogged .frame__media { filter: sepia(0.65) contrast(0.85) brightness(1.04); }
  .frame.is-fogged::before {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; mix-blend-mode: multiply; opacity: 0.8;
    background:
      radial-gradient(40% 50% at 12% 85%, color-mix(in oklab, var(--sepia-dim) 45%, transparent), transparent 70%),
      radial-gradient(28% 38% at 88% 14%, color-mix(in oklab, var(--sepia-dim) 35%, transparent), transparent 70%),
      radial-gradient(18% 22% at 60% 60%, color-mix(in oklab, var(--sepia) 18%, transparent), transparent 70%);
  }

  /* interactive frames lift off the sheet */
  .frame.is-interactive { cursor: pointer; }
  .frame.is-interactive:hover { translate: 0 -3px; box-shadow: var(--shadow-lift); }
  .frame.is-interactive:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }

  /* a frame lying on film stock: its holes open onto paper, or the rails would read as blank bars */
  :global(.surface-stock) .frame { background: linear-gradient(to right, var(--paper) var(--rail), var(--frame-bg) var(--rail) calc(100% - var(--rail)), var(--paper) calc(100% - var(--rail))); }

  /* inside a strip, the strip's horizontal rails carry the perforations */
  :global(.strip) .frame { --rail: 0px; border-block: 0; box-shadow: none; }
  :global(.strip) .frame__rail { display: none; }
  :global(.strip) .frame__numeral { left: var(--s-4); }
  :global(.strip) .frame.is-interactive:hover { box-shadow: 0 0 0 1px var(--stock), 0 1.5rem 2rem -1.25rem rgb(0 0 0 / 0.6); }
</style>
