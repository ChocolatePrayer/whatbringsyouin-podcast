---
// The show's mark: the microphone from the podcast logo (the McIntyre tower as the mic head,
// the red cord wound round the stand). Cut from WBYI-podcast-logo.jpeg to a transparent PNG.
// `tone="white"` reverses it for stock and red surfaces.
import { Image } from 'astro:assets';
import mic from '../assets/brand/wbyi-mic.png';
interface Props { size?: number; tone?: 'ink' | 'white'; class?: string; [key: string]: unknown }
const { size = 36, tone = 'ink', class: cls, ...rest } = Astro.props;
---
<Image src={mic} alt="" height={size} densities={[1, 2]} class:list={['mark', `mark--${tone}`, cls]} aria-hidden="true" {...rest} />
<style>
  .mark { flex: none; width: auto; }
  .mark--white { filter: brightness(0) invert(1); }
</style>
