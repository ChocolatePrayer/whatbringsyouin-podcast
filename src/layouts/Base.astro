---
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '@fontsource-variable/caveat';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site';
import { withBase } from '../lib/url';

interface Props { title?: string; description?: string; bodyClass?: string }
const { title, description = site.description, bodyClass } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · A podcast for medical students`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <!--
    THESIS: The reel laid out on a McGill archive table: every episode a white print held in grey perforated stock, the frame that matters burned McGill red through its perforations and circled in red china marker. Refuses the university-template banner, crest and card grid, and the cream-serif editorial default.
    OWN-WORLD: White archive paper, beige folder bands, graphite film stock for rails, strips, plates and the footer; one McGill red, the logo's own #AF2825, for the lit frame, current page and primary action. Cinzel Roman capitals from the logo, Source Serif 4 for reading, Libre Franklin edge codes, china-marker numerals. Prints develop out of white paper.
    STORY: A med student meets the show's own logo as the title card, sees a reel of senior voices waiting to develop, and follows or joins.
    FIRST VIEWPORT: The logo printed large in a title-card frame, left, eight of twelve columns, its red leak burning in once; tagline, primary "Hear the first reel", secondary "Join the team" and follow marks right.
    FORM: User-pinned 16mm film world, recoloured for McGill's Faculty of Medicine (no roll: the pin beats it); prior seed ff201de7.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="wax" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="1.8" /></filter></svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <div class="grain" aria-hidden="true"></div>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
